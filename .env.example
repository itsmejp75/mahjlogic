# Copy to `.env.local` and fill from Supabase → Project Settings → API.
# This is a Vite app — use VITE_ prefixes (not NEXT_PUBLIC_).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional legacy alias:
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Same Web Client ID as Supabase → Auth → Providers → Google (public).
# Enables Google Identity Services so Google says “continue to” this site’s origin
# (mahjlogic.com / localhost) instead of *.supabase.co. Set on Vercel for production.
# Google Cloud → Web client → Authorized JavaScript origins:
#   http://localhost:5173
#   https://mahjlogic.com
#   https://www.mahjlogic.com   (if you use www)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
